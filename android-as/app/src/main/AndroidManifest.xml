<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="${applicationLabel}"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity android:name=".features.scan.ScanActivity" android:exported="false" />
      <activity android:name=".rnhost.DeviceActivity" android:exported="false" android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
      <activity android:name=".features.auth.AgreementActivity" android:exported="false" />
      <activity android:name=".features.auth.RecoveryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
      <activity android:name=".features.auth.RegistrationActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
      <activity android:name=".features.auth.RegionSelectionActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
      <activity android:name=".features.rooms.RoomsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
      <activity android:name=".features.preferences.PreferencesActivity" android:exported="false" />
      <activity android:name=".features.mine.MineActivity" android:exported="false" />
      <activity android:name=".features.products.ProductCatalogActivity" android:exported="false" />
      <activity android:name=".features.products.ProductDetailsActivity" android:exported="false" />
      <activity android:name=".features.home.HomeActivity" android:exported="false" />
      <activity android:name=".features.auth.WelcomeActivity" android:exported="true" android:theme="@style/StartupTheme">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
      <activity
        android:name=".features.auth.AccountActivity"
        android:label="${applicationLabel}"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="false">
      </activity>
    </application>
</manifest>
