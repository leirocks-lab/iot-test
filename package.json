{
  "name": "rowan-iot-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "doctor": "expo-doctor",
    "specs:index": "node sdd/维护工具/规范维护.mjs index",
    "specs:check": "node sdd/维护工具/规范维护.mjs check",
    "specs:search": "node sdd/维护工具/规范维护.mjs search",
    "specs:test": "node --test sdd/维护工具/规范维护测试.mjs",
    "verify:config": "node scripts/verify-app-config.mjs",
    "verify:bundle": "pnpm export:android && pnpm export:ios",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm run doctor && pnpm verify:config && pnpm verify:bundle",
    "start": "expo start --dev-client",
    "export:android": "expo export --platform android --output-dir dist/android",
    "web": "expo start --web",
    "export:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0",
    "yaml": "2.9.1"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "buffer": "^6.0.3",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "mqtt": "^5.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  }
}
