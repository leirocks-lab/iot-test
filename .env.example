# Public build selectors only. Never place tokens, signing keys, or device secrets here.
APP_BRAND=rowan
APP_ENV=development
# All environments use real APIs; development/preview support HTTP or HTTPS.
# Production requires HTTPS for BOTH module roots.
# HTTP console diagnostics: off | error | debug. Default: development/preview=debug, production=off.
# ROWAN_HTTP_LOG_LEVEL=debug
# Real MQTT console diagnostics only: off | error | debug. Independent of HTTP; Mock stays silent.
# Default: development/preview=debug, production=off. JSON payloads are redacted and capped at 4KB.
# ROWAN_MQTT_LOG_LEVEL=debug
ROWAN_APP_API_BASE_URL=https://your-api.example.com
# Optional separate IoT module root; do not append /app-api to either root.
# ROWAN_IOT_API_BASE_URL=https://your-api.example.com/iot
# Current Rowan backend example for development integration:
# ROWAN_APP_API_BASE_URL=https://47.107.80.36
# ROWAN_IOT_API_BASE_URL=https://47.107.80.36/iot
# ROWAN_TENANT_ID=1
# Confirm the tenant for the target backend. No accounts or tokens belong here.
# Native policy changes require a rebuilt Development Build; Metro reload is insufficient.
# Use the backend-issued tenant ID. No tenant or token is inferred from Swagger examples.
# ROWAN_TENANT_ID=
# Optional public ID of a reviewed adapter registered in src/config/deployment-integrations.ts.
# V1.6 readonly Shadow adapter or dual 0922/0822 BLE adapter for development/preview.
# Select explicitly for the target deployment.
# ROWAN_INTEGRATION_PROFILE=rowan-v16-shadow
# ROWAN_INTEGRATION_PROFILE=rowan-ble-dual
