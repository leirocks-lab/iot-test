# Public build selectors only. Never place tokens, signing keys, or device secrets here.
APP_BRAND=rowan
APP_ENV=development
# Development and preview default to mock. Production requires real modes and HTTPS.
ROWAN_HTTP_MODE=mock
ROWAN_DEVICE_MODE=mock
# ROWAN_APP_API_BASE_URL=https://your-api.example.com
# Optional separate IoT module root; do not append /app-api to either root.
# ROWAN_IOT_API_BASE_URL=https://your-api.example.com/iot
# Use the backend-issued tenant ID. No tenant or token is inferred from Swagger examples.
# ROWAN_TENANT_ID=
