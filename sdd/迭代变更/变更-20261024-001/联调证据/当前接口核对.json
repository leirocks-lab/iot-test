            },
            "success": {
              "type": "boolean"
            }
          }
        },
        "AppThingModelRespVO": {
          "type": "object",
          "description": "THING-01 获取已发布物模型 Response VO",
          "properties": {
            "version": {
              "type": "string",
              "description": "物模型版本",
              "example": "tm_3"
            },
            "attributes": {
              "type": "array",
              "description": "属性定义（标识、类型、范围、单位、读写权限）",
              "items": {
