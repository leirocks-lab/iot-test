              "description": "服务定义（服务标识及输入/输出参数）",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "events": {
              "type": "array",
              "description": "事件定义（事件标识、等级及参数）",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "etag": {
