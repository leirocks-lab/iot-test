          ]
        },
        "AppMqttRespVO": {
          "type": "object",
          "description": "DEVICE-01 获取设备 MQTT 链接 Response VO",
          "properties": {
            "host": {
              "type": "string",
              "description": "MQTT 链接",
              "example": "wss://mqtt.rowan.com/mqtt"
            },
            "endpoint": {
              "type": "string",
              "description": "MQTT 域名",
              "example": "mqtt.rowan.com"
            },
            "path": {
              "type": "string",
              "description": "MQTT 路径",
              "example": "/mqtt"
            },
            "clientID": {
              "type": "string",
