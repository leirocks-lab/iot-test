              "example": "dev_01J0ROWAN0001"
            },
            "sessionToken": {
              "type": "string",
              "description": "会话令牌（AWS STS 临时凭证必需；SigV4 over MQTT 认证三要素之一）",
              "example": "IQoJb3JpZ2luX2Vj..."
            }
          },
          "required": [
