# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1] + "/../app-rn"]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
project 'Rowan',
  'DevelopmentDebug' => :debug,
  'DevelopmentRelease' => :release,
  'PreviewDebug' => :debug,
  'PreviewRelease' => :release,
  'ProductionDebug' => :debug,
  'ProductionRelease' => :release
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# Candidate only: exact source tag; Pods/Xcode/WSS integration not validated on Windows.
# Do not generate or handwrite a Podfile.lock until an actual macOS dependency resolution.
target 'Rowan' do
  pod 'CocoaMQTT/WebSockets', :git => 'https://github.com/emqx/CocoaMQTT.git', :tag => '2.4.1'
  config = use_native_modules!(["node", "../app-rn/node_modules/react-native/cli.js", "config"])

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/../app-rn"
  )

  target 'RowanTests' do
    inherit! :search_paths
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
